        { "zh": "再", "py": "zài", "pos": "phó từ", "vi": "lại, nữa, thêm", "ex": "再买一斤。", "ex_vi": "Mua thêm một cân nữa." },
        { "zh": "毛", "py": "máo", "pos": "lượng từ", "vi": "hào (1/10 đồng, khẩu ngữ của 角)", "ex": "三块五毛。", "ex_vi": "Ba tệ năm hào." }
      ],
      "names": [],
      "lines": [
        { "zh": "（马丁在市场。）", "vi": "(Martin ở chợ.)" },
        { "s": "马丁", "zh": "请问，香蕉多少钱一斤？", "vi": "Xin hỏi, chuối bao nhiêu tiền một cân?" },
        { "s": "营业员", "zh": "一块八一斤。", "vi": "Một tệ tám một cân." },
        { "s": "马丁", "zh": "苹果呢？", "vi": "Còn táo thì sao?" },
        { "s": "营业员", "zh": "三块五一斤。您买多少？", "vi": "Ba tệ rưỡi một cân. Ông mua bao nhiêu?" },
        { "s": "马丁", "zh": "我买四斤香蕉，再买三斤苹果。一共多少钱？", "vi": "Tôi mua bốn cân chuối, mua thêm ba cân táo. Tổng cộng bao nhiêu tiền?" },
        { "s": "营业员", "zh": "一共十七块七（毛）。", "vi": "Tổng cộng mười bảy tệ bảy (hào)." }
      ]
    }
  ],
