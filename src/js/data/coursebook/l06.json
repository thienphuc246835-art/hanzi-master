      ],
      "names": [],
      "lines": [
        { "zh": "（马丁在面包店。）", "vi": "(Martin ở tiệm bánh mì.)" },
        { "s": "营业员", "zh": "你好！请问，你要什么？", "vi": "Xin chào! Cho hỏi, bạn muốn mua gì?" },
        { "s": "马丁", "zh": "我要一个面包。", "vi": "Tôi lấy một cái bánh mì." },
        { "s": "营业员", "zh": "你要哪种？", "vi": "Bạn lấy loại nào?" },
        { "s": "马丁", "zh": "我要这种，这种多少钱一个？", "vi": "Tôi lấy loại này, loại này bao nhiêu tiền một cái?" },
        { "s": "营业员", "zh": "这种四块五一个。", "vi": "Loại này bốn tệ rưỡi một cái." },
        { "s": "马丁", "zh": "我要两个。", "vi": "Tôi lấy hai cái." },
        { "s": "营业员", "zh": "一共九块。", "vi": "Tổng cộng chín tệ." },
        { "s": "马丁", "zh": "谢谢！", "vi": "Cảm ơn!" },
        { "s": "营业员", "zh": "不客气！", "vi": "Không có gì!" }
      ]
    },
