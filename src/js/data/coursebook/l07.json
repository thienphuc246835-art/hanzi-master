{
  "number": 7, "title_zh": "中国银行在哪儿", "title_en": "Where Is the Bank of China", "title_vi": "Ngân hàng Trung Quốc ở đâu?",
  "texts": [
    {
      "heading": "课文一",
      "vocab": [
        { "zh": "教学楼", "py": "jiàoxuélóu", "pos": "danh từ", "vi": "tòa nhà giảng đường", "ex": "教学楼在图书馆东边。", "ex_vi": "Tòa giảng đường ở phía đông thư viện." },
        { "zh": "教学", "py": "jiàoxué", "pos": "động từ", "vi": "dạy học, giảng dạy", "ex": "他在大学教学。", "ex_vi": "Ông ấy dạy học ở trường đại học." },
        { "zh": "楼", "py": "lóu", "pos": "danh từ", "vi": "tòa nhà, tầng lầu", "ex": "这是留学生楼。", "ex_vi": "Đây là tòa nhà lưu học sinh." },
        { "zh": "在", "py": "zài", "pos": "động từ", "vi": "ở, tại (chỉ vị trí của người/vật)", "ex": "我在教学楼。", "ex_vi": "Tôi ở tòa giảng đường." },
        { "zh": "这儿", "py": "zhèr", "pos": "đại từ", "vi": "ở đây, chỗ này", "ex": "我们在这儿。", "ex_vi": "Chúng tôi ở đây." },
        { "zh": "图书馆", "py": "túshūguǎn", "pos": "danh từ", "vi": "thư viện", "ex": "我在图书馆学习。", "ex_vi": "Tôi học ở thư viện." },
        { "zh": "……边", "py": "biān", "pos": "hậu tố", "vi": "phía, bên (hậu tố chỉ phương hướng)", "ex": "图书馆在东边。", "ex_vi": "Thư viện ở phía đông." },
        { "zh": "北边", "py": "běibian", "pos": "danh từ", "vi": "phía bắc", "ex": "银行在超市北边。", "ex_vi": "Ngân hàng ở phía bắc siêu thị." },
        { "zh": "西边", "py": "xībian", "pos": "danh từ", "vi": "phía tây", "ex": "体育馆在西边。", "ex_vi": "Nhà thi đấu ở phía tây." },
        { "zh": "南边", "py": "nánbian", "pos": "danh từ", "vi": "phía nam", "ex": "饭馆在南边。", "ex_vi": "Nhà hàng ở phía nam." },
        { "zh": "运动场", "py": "yùndòngchǎng", "pos": "danh từ", "vi": "sân vận động, sân thể thao", "ex": "运动场很大。", "ex_vi": "Sân thể thao rất rộng." },
        { "zh": "体育馆", "py": "tǐyùguǎn", "pos": "danh từ", "vi": "nhà thi đấu, phòng tập thể thao", "ex": "我去体育馆。", "ex_vi": "Tôi đến nhà thi đấu." },
        { "zh": "饭馆", "py": "fànguǎn", "pos": "danh từ", "vi": "quán ăn, nhà hàng", "ex": "这儿有一个饭馆。", "ex_vi": "Ở đây có một quán ăn." },
        { "zh": "还", "py": "hái", "pos": "phó từ", "vi": "còn, thêm, vẫn", "ex": "我还要一个面包。", "ex_vi": "Tôi còn lấy thêm một cái bánh mì." },
        { "zh": "超市", "py": "chāoshì", "pos": "danh từ", "vi": "siêu thị", "ex": "我去超市买苹果。", "ex_vi": "Tôi đi siêu thị mua táo." }
      ],
      "names": [],
      "lines": [
        { "zh": "这是教学一楼，我们在这儿。图书馆在教学一楼北边，运动场和体育馆在教学一楼西边。这是留学生楼，留学生楼在运动场南边，留学生楼西边有一个饭馆，还有一个超市。", "vi": "Đây là giảng đường số 1, chúng ta đang ở đây. Thư viện ở phía bắc giảng đường số 1, sân thể thao và nhà thi đấu ở phía tây giảng đường số 1. Đây là tòa nhà lưu học sinh, nó ở phía nam sân thể thao; phía tây tòa nhà lưu học sinh có một quán ăn và còn có một siêu thị." }
      ]
    },
    {
      "heading": "课文二",
