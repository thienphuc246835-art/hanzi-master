      ],
      "names": [
        { "zh": "中国银行", "py": "Zhōngguó Yínháng", "vi": "Ngân hàng Trung Quốc (Bank of China)" }
      ],
      "lines": [
        { "s": "马丁", "zh": "山田，你去哪儿？", "vi": "Yamada, bạn đi đâu đấy?" },
        { "s": "山田", "zh": "我去超市。", "vi": "Tôi đi siêu thị." },
        { "s": "马丁", "zh": "中国银行在哪儿？你知道吗？", "vi": "Ngân hàng Trung Quốc ở đâu? Bạn có biết không?" },
        { "s": "山田", "zh": "知道，在超市东边。我跟你一起去吧。", "vi": "Biết, ở phía đông siêu thị. Tôi đi cùng bạn nhé." },
        { "s": "马丁", "zh": "太好了！", "vi": "Tốt quá!" }
      ]
    },
    {
      "heading": "课文三",
      "vocab": [
        { "zh": "卫生间", "py": "wèishēngjiān", "pos": "danh từ", "vi": "nhà vệ sinh, toilet", "ex": "卫生间在哪儿？", "ex_vi": "Nhà vệ sinh ở đâu?" },
        { "zh": "对不起", "py": "duìbuqǐ", "pos": "động từ", "vi": "xin lỗi", "ex": "对不起，我不知道。", "ex_vi": "Xin lỗi, tôi không biết." },
        { "zh": "没关系", "py": "méi guānxi", "pos": "cụm từ", "vi": "không sao, không có gì", "ex": "A：对不起！B：没关系。", "ex_vi": "A: Xin lỗi! B: Không sao." },
        { "zh": "商店", "py": "shāngdiàn", "pos": "danh từ", "vi": "cửa hàng, tiệm", "ex": "商店里有苹果。", "ex_vi": "Trong cửa hàng có táo." },
        { "zh": "里边", "py": "lǐbian", "pos": "danh từ", "vi": "bên trong", "ex": "商店里边有一个银行。", "ex_vi": "Bên trong cửa hàng có một ngân hàng." },
        { "zh": "地方", "py": "dìfang", "pos": "danh từ", "vi": "nơi, chỗ, địa điểm", "ex": "这是什么地方？", "ex_vi": "Đây là chỗ nào?" },
        { "zh": "前边", "py": "qiánbian", "pos": "danh từ", "vi": "phía trước, đằng trước", "ex": "超市在前边。", "ex_vi": "Siêu thị ở phía trước." },
        { "zh": "看", "py": "kàn", "pos": "động từ", "vi": "nhìn, xem", "ex": "你看，那是银行。", "ex_vi": "Bạn nhìn kìa, đó là ngân hàng." },
        { "zh": "那儿", "py": "nàr", "pos": "đại từ", "vi": "ở kia, chỗ đó", "ex": "银行在那儿。", "ex_vi": "Ngân hàng ở đằng kia." },
        { "zh": "就", "py": "jiù", "pos": "phó từ", "vi": "chính là, ngay (nhấn mạnh)", "ex": "那儿就是图书馆。", "ex_vi": "Chỗ kia chính là thư viện." }
      ],
      "names": [],
      "lines": [
        { "zh": "（阿明在路上找卫生间。）", "vi": "(A Minh đang tìm nhà vệ sinh trên đường.)" },
        { "s": "阿明", "zh": "请问，哪儿有卫生间？", "vi": "Xin hỏi, ở đâu có nhà vệ sinh?" },
        { "s": "学生A", "zh": "对不起，我不知道。", "vi": "Xin lỗi, tôi không biết." },
        { "s": "阿明", "zh": "没关系。请问，你知道哪儿有卫生间吗？", "vi": "Không sao. Xin hỏi, bạn có biết ở đâu có nhà vệ sinh không?" },
        { "s": "学生B", "zh": "商店里边有。", "vi": "Bên trong cửa hàng có." },
        { "s": "阿明", "zh": "商店在什么地方？", "vi": "Cửa hàng ở chỗ nào?" },
        { "s": "学生B", "zh": "在前边。你看，那儿就是。", "vi": "Ở phía trước. Bạn nhìn kìa, chỗ đó chính là cửa hàng." },
        { "s": "阿明", "zh": "谢谢！", "vi": "Cảm ơn!" },
        { "s": "学生B", "zh": "不客气。", "vi": "Không có gì." }
      ]
    }
  ],
