        { "zh": "银行", "py": "yínháng", "pos": "danh từ", "vi": "ngân hàng", "ex": "银行在哪儿？", "ex_vi": "Ngân hàng ở đâu?" },
        { "zh": "知道", "py": "zhīdào", "pos": "động từ", "vi": "biết", "ex": "我知道他的名字。", "ex_vi": "Tôi biết tên của anh ấy." },
        { "zh": "东边", "py": "dōngbian", "pos": "danh từ", "vi": "phía đông", "ex": "超市在银行东边。", "ex_vi": "Siêu thị ở phía đông ngân hàng." },
        { "zh": "跟", "py": "gēn", "pos": "giới từ", "vi": "cùng với, với", "ex": "我跟朋友一起去。", "ex_vi": "Tôi đi cùng bạn." },
        { "zh": "吧", "py": "ba", "pos": "trợ từ", "vi": "nhé, đi (cuối câu, ngụ ý đề nghị nhẹ nhàng)", "ex": "我们一起去吧。", "ex_vi": "Chúng ta cùng đi nhé." },
        { "zh": "太", "py": "tài", "pos": "phó từ", "vi": "quá, rất", "ex": "太好了！", "ex_vi": "Tốt quá!" },
