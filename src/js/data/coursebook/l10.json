        { "zh": "忙", "py": "máng", "pos": "tính từ", "vi": "bận", "ex": "我今天很忙。", "ex_vi": "Hôm nay tôi rất bận." },
        { "zh": "听说", "py": "tīngshuō", "pos": "động từ", "vi": "nghe nói", "ex": "听说他是老师。", "ex_vi": "Nghe nói anh ấy là giáo viên." },
        { "zh": "出发", "py": "chūfā", "pos": "động từ", "vi": "xuất phát, khởi hành", "ex": "我们八点出发。", "ex_vi": "Chúng ta xuất phát lúc tám giờ." },
        { "zh": "找", "py": "zhǎo", "pos": "động từ", "vi": "tìm, tìm gặp", "ex": "我去找朋友。", "ex_vi": "Tôi đi tìm bạn." }
      ],
      "names": [],
      "lines": [
        { "s": "马丁", "zh": "这个星期天你忙不忙？", "vi": "Chủ nhật này bạn có bận không?" },
        { "s": "朋友", "zh": "我不忙。", "vi": "Tôi không bận." },
        { "s": "马丁", "zh": "星期天我们去爬山，你去不去？", "vi": "Chủ nhật chúng tôi đi leo núi, bạn có đi không?" },
        { "s": "朋友", "zh": "你们去哪儿爬山？", "vi": "Các bạn đi leo núi ở đâu?" },
        { "s": "马丁", "zh": "去西山。", "vi": "Đi Tây Sơn." },
        { "s": "朋友", "zh": "听说西山非常漂亮，我也想跟你们一起去。", "vi": "Nghe nói Tây Sơn rất đẹp, tôi cũng muốn đi cùng các bạn." },
        { "s": "马丁", "zh": "太好了。我们早上八点出发。", "vi": "Tuyệt quá. Chúng tôi xuất phát lúc tám giờ sáng." },
        { "s": "朋友", "zh": "我七点半去找你。", "vi": "Bảy giờ rưỡi tôi sẽ đến tìm bạn." }
      ]
    },
