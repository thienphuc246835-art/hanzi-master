        { "zh": "累", "py": "lèi", "pos": "tính từ", "vi": "mệt", "ex": "我今天很累。", "ex_vi": "Hôm nay tôi rất mệt." },
        { "zh": "觉得", "py": "juéde", "pos": "động từ", "vi": "cảm thấy, thấy rằng", "ex": "我觉得汉语很有意思。", "ex_vi": "Tôi thấy tiếng Trung rất thú vị." },
        { "zh": "休息", "py": "xiūxi", "pos": "động từ", "vi": "nghỉ ngơi", "ex": "我们休息一下吧。", "ex_vi": "Chúng ta nghỉ một lát nhé." },
        { "zh": "一下", "py": "yíxià", "pos": "lượng từ", "vi": "một chút, một lát (đứng sau động từ)", "ex": "请你看一下。", "ex_vi": "Mời bạn xem một chút." },
        { "zh": "小", "py": "xiǎo", "pos": "tính từ", "vi": "nhỏ, bé", "ex": "这是一个小公园。", "ex_vi": "Đây là một công viên nhỏ." },
        { "zh": "茶馆", "py": "cháguǎn", "pos": "danh từ", "vi": "quán trà", "ex": "我们去茶馆吧。", "ex_vi": "Chúng ta đến quán trà nhé." },
        { "zh": "茶", "py": "chá", "pos": "danh từ", "vi": "trà", "ex": "我喜欢喝茶。", "ex_vi": "Tôi thích uống trà." },
        { "zh": "喝", "py": "hē", "pos": "động từ", "vi": "uống", "ex": "你喝什么？", "ex_vi": "Bạn uống gì?" },
        { "zh": "一点儿", "py": "yìdiǎnr", "pos": "lượng từ", "vi": "một chút, một ít", "ex": "我喝一点儿水。", "ex_vi": "Tôi uống một chút nước." }
      ],
      "names": [],
      "lines": [
        { "zh": "（崔浩和朋友们一起在西山爬山。）", "vi": "(Thôi Hạo cùng các bạn leo núi ở Tây Sơn.)" },
        { "s": "崔浩", "zh": "大家累不累？", "vi": "Mọi người có mệt không?" },
        { "s": "林娜", "zh": "累！", "vi": "Mệt!" },
        { "s": "马丁", "zh": "我也觉得很累，我们休息一下吧。", "vi": "Tôi cũng thấy rất mệt, chúng ta nghỉ một lát nhé." },
        { "s": "崔浩", "zh": "前边有一个小茶馆，我们去那儿喝一点儿茶，好不好？", "vi": "Phía trước có một quán trà nhỏ, chúng ta đến đó uống chút trà, được không?" },
        { "s": "大家", "zh": "好啊！", "vi": "Được chứ!" }
      ]
